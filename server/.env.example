PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/facebook_automation

# Facebook Page Credentials (Backend only - never expose to client)
FACEBOOK_PAGE_ID=your_facebook_page_id
FACEBOOK_PAGE_ACCESS_TOKEN=your_long_lived_page_access_token
FACEBOOK_GRAPH_API_VERSION=v25.0

# Allowed Client Origin
CLIENT_URL=http://localhost:5173

# Google Gemini (backend only — never expose to Vite)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# News automation scheduler (node-cron, in-process)
NEWS_SCHEDULER_ENABLED=true
NEWS_SCHEDULER_CRON=* * * * *
